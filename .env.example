# Coaching-interest signups are stored in Vercel Postgres. Attaching a Postgres
# database to the project (Vercel dashboard → Storage) injects POSTGRES_URL
# automatically — you normally don't set this by hand.
POSTGRES_URL=

# Token to export signups via GET /api/coach-interest?token=...  (&format=csv).
# Set to a long random string; required for the export endpoint to work.
ADMIN_EXPORT_TOKEN=

# --- Weekly analytics agent (GA4 Data API) ---
# Token protecting GET /api/ga-weekly?token=...
GA_REPORT_TOKEN=
# GA4 property id (the `p…` part of the admin URL). Defaults to 539727341.
GA_PROPERTY_ID=
# Auth option A — OAuth as your own Google account (run scripts/oauth-setup.mjs):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Auth option B — service account JSON (Viewer on the property), inline:
GA_SA_KEY=

# Optional fallback only used when no POSTGRES_URL is configured: forward each
# signup to a webhook (Zapier/Make/Airtable/Google Sheet).
COACH_INTEREST_WEBHOOK_URL=

# --- Email notification when a coach applies (Resend) ---
# Create a key at resend.com. If unset, no email is sent (application still saves).
RESEND_API_KEY=
# Where to send the notification (defaults to the owner's email).
NOTIFY_EMAIL=
# Verified sender. The legacy public form falls back to Resend's onboarding
# sender for owner-only testing. Marketplace alerts require this explicitly.
NOTIFY_FROM=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When set, the GA4 gtag is loaded site-wide. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Optional PostHog project token and matching regional ingestion host.
# PostHog stays disabled until both are set. Use the values from your PostHog project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Stripe Connect: OPERATOR-ONLY TEST HARNESS, never live payments ---
# Off by default. The code accepts only the exact value "test" and sk_test_ keys.
STRIPE_PAYMENTS_MODE=off
STRIPE_SECRET_KEY=
STRIPE_PLATFORM_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Fixed return origin, never inferred from a request Host header.
STRIPE_APP_URL=http://localhost:3010
# Separate, random 32+ character bearer credential; do not reuse the export token.
PAYMENTS_ADMIN_TOKEN=
# ISOLATED test Postgres database; apply db/migrations/001_test_payments.sql there.
# Use verified TLS for remote databases. Never use the production lead database.
PAYMENTS_DATABASE_URL=
# Server-only JSON array of approved test offers; see STRIPE.md. No real coaches
# are enrolled by this configuration, and no price/commission is assumed.
STRIPE_TEST_OFFERS=[]

# Independent live webhook INBOX only. Does not enable checkout or paid access.
# Apply db/migrations/003_stripe_live_event_inbox.sql explicitly before enabling.
STRIPE_WEBHOOK_MODE=off
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PLATFORM_ACCOUNT_ID=
# Explicitly choose POSTGRES_URL (existing Anystride DB) or STRIPE_EVENT_DATABASE_URL.
# No automatic fallback to the test payment database; remote TLS is verified.
STRIPE_EVENT_DATABASE_SOURCE=
STRIPE_EVENT_DATABASE_URL=
# Optional PEM root CA from the selected database provider's verified dashboard.
# Scoped to this inbox connection only. Never disable certificate verification.
STRIPE_EVENT_DATABASE_CA=

# Coaching account pilot. Independent of Stripe; no public checkout enabled.
# Reuse the existing Anystride Supabase project; configure email auth and redirects.
MARKETPLACE_MODE=off
MARKETPLACE_APP_URL=http://localhost:3010
MARKETPLACE_DATABASE_URL=
# Optional explicit reuse of POSTGRES_URL; otherwise use the dedicated URL above.
MARKETPLACE_DATABASE_SOURCE=
# PEM root CA from the selected provider; remote verification always stays enabled.
MARKETPLACE_DATABASE_CA=
# Optional comma-separated email invitations for a closed pilot; server-only.
# Checked for email requests AND verified sessions. Never grants admin privileges.
MARKETPLACE_PILOT_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase user IDs. Never emails or user-editable metadata.
MARKETPLACE_ADMIN_USER_IDS=

# Reviewer alerts for new applications/services; set to email to enable.
# Requires RESEND_API_KEY and a verified NOTIFY_FROM sender (defined above).
# NOTIFY_EMAIL defaults to the owner; do not enable on preview deployments.
MARKETPLACE_REVIEW_NOTIFICATIONS=off
# Optional dedicated, sending-only Resend key scoped to anystride.com.
# Takes precedence over the legacy RESEND_API_KEY without changing other mail.
MARKETPLACE_RESEND_API_KEY=

# Isolated sandbox milestone only. Hard-disabled on Vercel Production.
# Requires matching MARKETPLACE_APP_URL / STRIPE_APP_URL and existing test config.
MARKETPLACE_SANDBOX_WORKSPACES=off
# Operator-reviewed binding: [{"serviceId":"<UUID>","coachUserId":"<verified user ID>","offerId":"<STRIPE_TEST_OFFERS id>"}]
# Offer title, total amount and currency must match the accepted service snapshot.
STRIPE_TEST_SERVICE_BINDINGS=[]

# Coach storefront purchases. Separate from the existing enquiry/test workspace.
# Apply 006_coach_storefronts.sql to the marketplace DB before using storefronts.
# Keep off until Connect onboarding, webhooks and a full Stripe test purchase pass.
STOREFRONT_PAYMENTS_MODE=off
STOREFRONT_STRIPE_SECRET_KEY=
STOREFRONT_STRIPE_PLATFORM_ACCOUNT_ID=
STOREFRONT_STRIPE_WEBHOOK_SECRET=
# Basis points: 500 means 5%. Zero means no platform commission.
STOREFRONT_PLATFORM_FEE_BPS=0
