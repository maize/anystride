# Optional: where coaching-interest form submissions are forwarded.
# Point this at a Zapier / Make / Airtable / Google-Sheet webhook to collect
# signups without a database. If unset, submissions are just logged server-side.
COACH_INTEREST_WEBHOOK_URL=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When set, the GA4 gtag is loaded site-wide. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
