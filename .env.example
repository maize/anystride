# Coaching-interest signups are stored in Vercel Postgres. Attaching a Postgres
# database to the project (Vercel dashboard → Storage) injects POSTGRES_URL
# automatically — you normally don't set this by hand.
POSTGRES_URL=

# Token to export signups via GET /api/coach-interest?token=...  (&format=csv).
# Set to a long random string; required for the export endpoint to work.
ADMIN_EXPORT_TOKEN=

# Optional fallback only used when no POSTGRES_URL is configured: forward each
# signup to a webhook (Zapier/Make/Airtable/Google Sheet).
COACH_INTEREST_WEBHOOK_URL=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# When set, the GA4 gtag is loaded site-wide. Leave empty to disable.
NEXT_PUBLIC_GA_ID=
